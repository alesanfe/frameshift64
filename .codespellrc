[codespell]
skip = .git,.venv-lint,build,build-lint,assets,decomp,libultraship,torch,mods/examples,.claude,node_modules,mods,out,*.o,*.a,*.dll,*.exe,*.png,*.jpg,*.jpeg,*.gif,*.zip,*.bin,*.otr,*.o2r,*.trace,*.z64,services/netplay-lobby/cloudflare/node_modules,x64
ignore-words-list = nd,th,fo,ba,ser,mos,hda,hist,crate,afile,te,siz,ue
quiet-level = 2
