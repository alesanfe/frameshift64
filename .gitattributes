# ---------------------------------------------------------------------------
# Line endings
# ---------------------------------------------------------------------------
# Generated YAMLs are written by tools/code-generation/generate_yamls.py with explicit
# LF endings. Without this, a Windows checkout with core.autocrlf=true would
# convert them to CRLF and show a spurious "modified" diff on every regen.
# Extended to ALL yaml: yamllint enforces LF and CRLF checkouts keep
# breaking the lint gate.
*.yml text eol=lf
*.yaml text eol=lf

# Committed codegen output — same rule.
generated/**/*.h text eol=lf
generated/**/*.cpp text eol=lf
assets/game/**/manifests/*.json text eol=lf

# Python tooling: LF on all platforms so committed sources don't drift.
*.py text eol=lf

# Shell scripts must stay LF or bash refuses to parse them.
*.sh text eol=lf

# PowerShell tolerates either; pinning LF keeps the repo consistent.
*.ps1 text eol=lf

# Batch files are Windows-native; CRLF is correct there.
*.bat text eol=crlf
*.cmd text eol=crlf

# CMake sources: CRLF (repo convention; cmake-lint line_ending=windows).
*.cmake text eol=crlf
CMakeLists.txt text eol=crlf

# ---------------------------------------------------------------------------
# Binary — never let git touch these
# ---------------------------------------------------------------------------
*.z64 binary
*.n64 binary
*.v64 binary
*.o2r binary
*.otr binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.zip binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.trace binary
*.dmp binary

# ---------------------------------------------------------------------------
# Linguist — external/vendored trees shouldn't count toward language stats
# ---------------------------------------------------------------------------
components/decomp/** linguist-vendored
components/libultraship/** linguist-vendored
components/game-runtime/** linguist-vendored
services/netplay-lobby/cloudflare/node_modules/** linguist-vendored
**/package-lock.json linguist-generated=true

# Generated code: collapse in PR diffs, exclude from stats.
generated/** linguist-generated=true
assets/game/**/*.yml linguist-generated=true
assets/game/**/manifests/*.json linguist-generated=true

# ---------------------------------------------------------------------------
# Release export — don't ship dev plumbing in `git archive` artifacts
# ---------------------------------------------------------------------------
.github/** export-ignore
.claude/** export-ignore
tests/** export-ignore
docs/** export-ignore
out/** export-ignore
.clang-tidy export-ignore
.codespellrc export-ignore
.yamllint.yml export-ignore
.pre-commit-config.yaml export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.gitmodules export-ignore
config/lint/** export-ignore
config/semgrep/** export-ignore
config/static-analysis/** export-ignore
