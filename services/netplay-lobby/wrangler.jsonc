{
  // BattleShip netplay lobby: room codes, endpoint exchange for UDP hole
  // punching, and a WebSocket relay fallback. One Durable Object per room.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smash-netplay",
  "main": "src/infrastructure/cloudflare/worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "NetplayRoom" }]
  },
  // One datapoint per room admission (role, outcome, protocol version) —
  // queryable for the Grafana dashboards in docs/observability/.
  "analytics_engine_datasets": [
    { "binding": "LOBBY_ANALYTICS", "dataset": "ssb64_netplay_lobby" }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NetplayRoom"] }]
}
