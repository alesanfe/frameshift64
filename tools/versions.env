# Toolchain version contract — sourced by `make versions` / `doctor`.
# MIN_* = minimum compatible; pin ranges when a tool is known to break.
# Last verified: 2026-10-15 (windows host, VS2022 BuildTools 17.x).

MIN_CMAKE=3.26
MIN_NINJA=1.11
MIN_PYTHON=3.11
MIN_NODE=20
MIN_NPM=10

# Compilers — informational (doctor reports, CI pins)
EXPECTED_MSVC=14.40      # VS2022 17.10+
EXPECTED_CLANG=17
EXPECTED_GCC=13

# Platform toolchains (optional builds)
MIN_POWERSHELL=7.2       # packaging scripts
EXPECTED_JAVA=17         # Android Gradle
EXPECTED_ANDROID_SDK=34
EXPECTED_DEVKITPRO=a64   # devkitA64 for Switch homebrew
