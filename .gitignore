# assets/game/<ver>/reloc_*.yml are COMMITTED.
# They're regenerated from tools/code-generation/reloc_data_symbols.<ver>.txt +
# ROM by tools/code-generation/generate_yamls.py; regen and re-commit when
# reloc_data_symbols.<ver>.txt changes (rare for a frozen v1.0).
# Their content (file_id ↔ symbol ↔ ROM offset/size) is a strict
# subset of upstream ssb-decomp-re's smashbrothers.<ver>.yaml splat
# config — standard decomp metadata, no ROM bytes.

# Decomp artifacts
asm/
*.d
*.ld
*.o
*.credits.encoded
*.credits.metadata
assets/*
!assets/branding/
!assets/fonts/
!assets/fonts/*
# Build inputs committed under assets/game/ — extraction recipes.
# Required at configure/build time on a fresh clone (RuntimeAssets.cmake,
# tools/code-generation/generate_reloc_table.py). Controller db lives in
# config/controllers/ (not ignored).
!assets/game/
!assets/lang/
__pycache__/
*.py[cod]
bin/
lib/
# Anchored: docs/specs/package-format/ is a tracked spec dir, not a dist-package drop.
/packages/
# Hi-res texture pack drops — src/resources/textures HiResPack scans
# CWD-relative `mods/` on Linux dev launches before falling back to
# <app-data>/mods/, so pack folders can land at the repo root during
# pack-authoring sessions. Always user-private content, never tracked.
# Root-anchored so it cannot match src/bridge/modding or mods/examples/*.
# Everything under mods/ is ignored except the SDK/example/template/tests
# skeleton that belongs to the repo.
/mods/*
!/mods/sdk/
!/mods/examples/
!/mods/templates/
!/mods/tests/
relocAssets/
undefined*
ctx.c
ctx.c.m2c
m2cfiles/
us_report.json

# Decomp tools (not needed for port — they live inside the components/decomp/
# submodule; anchored paths keep them out if it is ever flattened)
components/decomp/tools/ido-recomp/
components/decomp/tools/vpk0cmd
components/decomp/tools/halAssetTool

# Autogenerated — ROM-free codegen outputs (reloc_data.<ver>.h,
# RelocFileTable.<ver>.*) are emitted into the build tree
# (out/build/*/generated/) by GenerateRelocArtifacts and are never
# committed. The only versioned generated file is
# generated/src/<ver>/ssb64_reloc_rebuild.<ver>.cpp, whose generator
# needs a real baserom — see docs/development/generated-dir.md. Guard the old
# source-root locations so a stray manual regen can't re-add them:
generated/include/
generated/src/*/RelocFileTable.*
symbols/reloc_data_symbols.*

