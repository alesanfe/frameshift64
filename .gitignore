# Build inputs committed under assets/ — controller db + extraction recipes.
# Required at configure/build time on a fresh clone (RuntimeAssets.cmake,
# tools/codegen/generate_reloc_table.py).
!assets/recipes/
!assets/recipes/**
!assets/controllers/
!assets/controllers/**
__pycache__
bin/
# Hi-res texture pack drops — src/resources/textures HiResPack scans
# CWD-relative `mods/` on Linux dev launches before falling back to
# <app-data>/mods/, so pack folders can land at the repo root during
# pack-authoring sessions. Always user-private content, never tracked.
# Root-anchored so it cannot match src/bridge/modding or mods/examples/*.
# Everything under mods/ is ignored except the SDK/example/template/tests
# skeleton that belongs to the repo.
/mods/*
!/mods/sdk/
!/mods/examples/
!/mods/templates/
!/mods/tests/
!/mods/README.md
relocAssets/
undefined*
ctx.c
ctx.c.m2c
m2cfiles/
us_report.json

# Decomp tools (not needed for port — they live inside the decomp/
# submodule; anchored paths keep them out if it is ever flattened)
decomp/tools/ido-recomp/
decomp/tools/vpk0cmd
decomp/tools/halAssetTool

# Autogenerated — but include/reloc_data.h is now COMMITTED so CI builds
# can run without the ROM. It contains only #defines mapping symbol
# names to small integer IDs; no ROM bytes. Same pattern as
# port/resource/RelocFileTable.cpp, which has been committed since
# inception.
symbols/reloc_data_symbols.*

