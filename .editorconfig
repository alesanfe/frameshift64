# EditorConfig — applies to project code; submodules (components/decomp/, components/libultraship/,
# components/game-runtime/) keep their own conventions and are not reformatted.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml}]
indent_size = 2

[*.{yml,yaml}]
end_of_line = lf

[*.ps1]
end_of_line = crlf

[Makefile]
indent_style = tab
